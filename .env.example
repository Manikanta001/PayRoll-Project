# MongoDB Connection URI
# Option 1: Local MongoDB (default)
MONGO_URI=mongodb://localhost:27017/payroll

# Option 2: MongoDB Atlas (Cloud) - USE THIS FOR RENDER DEPLOYMENT
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/payroll

# Server Port (Render assigns automatically, default 4000 for local)
PORT=4000

# Frontend URL for CORS (update with your Vercel frontend URL)
FRONTEND_URL=http://localhost:5173

# Environment (development or production)
NODE_ENV=development
