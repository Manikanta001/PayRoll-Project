# MongoDB Connection URI
# For local: mongodb://localhost:27017/payroll
# For MongoDB Atlas (required for Vercel): mongodb+srv://username:password@cluster.mongodb.net/payroll
MONGO_URI=mongodb://localhost:27017/payroll

# Server Port (local dev only, Vercel uses serverless)
PORT=4000

# Frontend URL for CORS (set in Vercel environment variables)
FRONTEND_URL=http://localhost:5173

# Environment
NODE_ENV=development
